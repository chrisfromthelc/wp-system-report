parameters:
    level: 5
    paths:
        - system-report.php
        - includes/
    excludePaths:
        - vendor/
        - tests/
    scanDirectories:
        - vendor/szepeviktor/phpstan-wordpress/
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
